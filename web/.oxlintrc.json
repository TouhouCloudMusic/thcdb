{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"env": {
		"browser": true
	},
	"ignorePatterns": [
		"**.gen.ts",
		"packages/api/**/gen.ts",
		"src/orval/**",
		"config/eslint/index.js",
		"src/locales/main.loader.js",
		"src/style/color/convert.ts",
		"src/constant/server.ts",
		"src/component/__legacy"
	],
	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"pedantic": "warn",
		"perf": "warn",
		"style": "warn",
		"restriction": "warn",
		"nursery": "warn"
	},
	"plugins": ["import", "jsx-a11y", "oxc", "promise", "typescript", "unicorn"],
	"jsPlugins": ["eslint-plugin-solid"],
	"settings": {
		"jsx-a11y": {
			"attributes": {
				"for": ["for"]
			},
			"polymorphicPropName": "as"
		}
	},
	"rules": {
		// Temporary off
		"import/no-relative-parent-imports": "off",
		// In practice, we rarely mutate function inputs.
		// The codebase generally favors a functional style, so this rule
		// is too intrusive. We therefore disable it.
		"typescript/prefer-readonly-parameter-types": "off",
		// Replaced by typescript/switch-exhaustiveness-check
		"default-case": "off",
		// We use typescript alternative
		"require-await": "off",
		"typescript/no-confusing-void-expression": [
			"warn",
			{
				"ignoreArrowShorthand": true
			}
		],
		"typescript/only-throw-error": [
			"off",
			{
				"allow": ["notFound"]
			}
		],
		"func-style": "off",
		// We use modern js
		"unicorn/prefer-reflect-apply": "off",
		"no-use-before-define": "off",
		"no-eq-null": "off",
		"unicorn/require-module-specifiers": "off",
		"array-callback-return": [
			"off",
			{
				"allowImplicit": true
			}
		],
		"arrow-body-style": "off",
		"capitalized-comments": "off",
		"curly": "off",
		"eqeqeq": ["off", "smart"],
		"func-names": "off",
		"id-length": "off",
		"init-declarations": "off",
		"max-depth": ["warn", 4],
		"max-lines": [
			"off",
			{
				"max": 300,
				"skipBlankLines": true,
				"skipComments": true
			}
		],
		"max-lines-per-function": [
			"off",
			{
				"IIFEs": false,
				"max": 100,
				"skipBlankLines": true,
				"skipComments": true
			}
		],
		"max-statements": "off",
		"max-nested-callbacks": ["warn", 10],
		"max-params": [
			"warn",
			{
				"max": 4
			}
		],
		"new-cap": "off",
		"no-alert": "off",
		"no-async-await": "off",
		"no-continue": "off",
		"no-console": "off",
		"no-constructor-return": "off",
		"no-control-regex": "off",
		// Disable this, as type import is not recognized.
		// We use the import plugin instead.
		"no-duplicate-imports": "off",
		"no-else-return": "off",
		"no-empty-function": [
			"warn",
			{
				"allow": ["constructor", "privateConstructors", "protectedConstructors"]
			}
		],
		"no-inline-comments": "off",
		"no-warning-comments": "off",
		"no-magic-numbers": [
			"off",
			{
				"ignore": [-1, 0, 1, 2, 4, 8, 12, 16, 24, 60, 1000, 3600],
				"ignoreArrayIndexes": true
			}
		],
		"no-nested-ternary": "off",
		"no-plusplus": [
			"warn",
			{
				"allowForLoopAfterthoughts": true
			}
		],
		"no-ternary": "off",
		"no-undefined": "off",
		"no-unused-vars": "warn",
		"no-void": "off",
		"prefer-destructuring": "off",
		"sort-imports": "off", // We use prettier plugin
		"sort-keys": "off",
		"import/exports-last": "off",
		"import/group-exports": "off",
		"import/max-dependencies": "off",
		"import/no-anonymous-default-export": "off",
		"import/no-cycle": "off",
		"import/no-namespace": "off",
		"import/unambiguous": "off",
		"import/no-unassigned-import": [
			"error",
			{
				"allow": ["cropperjs", "**/*.css"]
			}
		],
		"import/prefer-default-export": "off",
		"import/no-named-export": "off",
		"oxc/no-barrel-file": "off",
		"oxc/no-const-enum": "off",
		"oxc/no-optional-chaining": "off",
		"oxc/no-rest-spread-properties": "off",
		"promise/prefer-await-to-then": "off",
		"promise/prefer-await-to-callbacks": "off",
		"promise/avoid-new": "off",
		"typescript/ban-ts-comment": "off",
		"typescript/consistent-type-definitions": "off",
		"typescript/explicit-function-return-type": "off",
		"typescript/explicit-module-boundary-types": "off",
		"typescript/consistent-return": "off",
		"typescript/strict-void-return": "off",
		"typescript/no-non-null-assertion": "off",
		"typescript/no-empty-object-type": [
			"warn",
			{
				"allowInterfaces": "with-single-extends"
			}
		],
		"typescript/promise-function-async": [
			"warn",
			{
				"checkArrowFunctions": false
			}
		],
		"typescript/prefer-enum-initializers": "off",
		"prefer-nullish-coalescing": [
			"warn",
			{
				"ignorePrimitives": true
			}
		],
		"typescript/strict-boolean-expressions": [
			"warn",
			{
				"allowAny": true,
				"allowString": true,
				"allowNullableObject": true,
				"allowNullableString": true,
				"allowNullableNumber": true,
				"allowNullableBoolean": true
			}
		],
		"unicorn/no-zero-fractions": "off",
		"unicorn/catch-error-name": "off",
		"unicorn/explicit-length-check": "off",
		"unicorn/filename-case": [
			"off",
			{
				"cases": {
					"camelCase": true,
					"snakeCase": true,
					"pascalCase": true
				}
			}
		],
		"unicorn/no-anonymous-default-export": "off",
		"unicorn/no-array-sort": "off",
		"unicorn/no-array-reduce": "off",
		"unicorn/no-array-callback-reference": "off",
		"unicorn/no-array-method-this-argument": "off",
		"unicorn/prefer-ternary": ["warn", "only-single-line"],
		// Dupe
		"unicorn/no-nested-ternary": "off",
		"unicorn/no-null": "off",
		"unicorn/no-useless-undefined": [
			"warn",
			{
				"checkArguments": false
			}
		],
		"unicorn/numeric-separators-style": "off",
		"unicorn/prefer-default-parameters": "off",
		"unicorn/prefer-spread": "off",
		"jsx-a11y/label-has-associated-control": [
			"error",
			{
				"controlComponents": ["Select.Trigger"],
				"depth": 3
			}
		],
		"solid/reactivity": "error",
		"solid/self-closing-comp": [
			"warn",
			{
				"component": "all",
				"html": "void"
			}
		]
	},
	"overrides": [
		{
			"files": [
				".storybook/*",
				"plugins/*.ts",
				"scripts/*.ts",
				"config/eslint/index.js",
				"*.stories.tsx",
				"*.config.{js,ts}"
			],
			"env": {
				"node": true,
				"es6": true
			},
			"rules": {
				"no-magic-numbers": "off",
				"import/no-default-export": "off",
				"import/no-nodejs-modules": "off",
				"no-console": "off",
				"typescript/no-unsafe-member-access": "off"
			}
		},
		{
			"files": ["*.test.ts", "*.test.tsx"],
			"plugins": ["vitest"],
			"rules": {
				"max-lines-per-function": "off",
				"unicorn/no-null": "off",
				"unicorn/no-useless-undefined": "off",
				"vitest/require-test-timeout": "off",
				"vitest/no-importing-vitest-globals": "off",
				"vitest/prefer-to-be-truthy": "off"
			}
		}
	]
}
