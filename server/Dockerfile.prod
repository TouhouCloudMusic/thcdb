# syntax=docker/dockerfile:1.20

ARG DEBIAN_VERSION=bookworm
ARG RUST_BUILDER_IMAGE=ghcr.io/touhoucloudmusic/thcdb-rust-builder:main
ARG WILD_LINKER_IMAGE=ghcr.io/touhoucloudmusic/thcdb-wild-linker-builder:main

FROM ${WILD_LINKER_IMAGE} AS wild-linker-builder

FROM ${RUST_BUILDER_IMAGE} AS chef
WORKDIR /app

COPY --from=wild-linker-builder /usr/local/cargo/bin/wild /usr/local/cargo/bin/wild

ENV RUSTFLAGS="-Clink-arg=--ld-path=wild -Zshare-generics=y"

FROM chef AS planner

COPY . ./

RUN rm -f rust-toolchain.toml rust-toolchain \
  && cargo chef prepare --recipe-path recipe.json

FROM chef AS builder

COPY --from=planner /app/recipe.json recipe.json

RUN --mount=type=cache,id=server_cargo_registry,target=/usr/local/cargo/registry \
  --mount=type=cache,id=server_cargo_git,target=/usr/local/cargo/git \
  --mount=type=cache,id=server_target_release,target=/app/target \
  cargo chef cook --release --recipe-path recipe.json --features release

COPY . ./

RUN rm -f rust-toolchain.toml rust-toolchain

RUN --mount=type=cache,id=server_cargo_registry,target=/usr/local/cargo/registry \
  --mount=type=cache,id=server_cargo_git,target=/usr/local/cargo/git \
  --mount=type=cache,id=server_target_release,target=/app/target \
  cargo build --release --features release \
  && install -Dm755 /app/target/release/thcdb-rs /out/thcdb-rs

FROM debian:${DEBIAN_VERSION}-slim AS runtime
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libgit2-1.5 \
    libssl3 \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd -r app \
  && useradd -r -g app -u 10001 app

COPY --from=builder /out/thcdb-rs /app/thcdb-rs
COPY ./config.toml /app/config.toml

RUN mkdir -p /app/public/image \
  && chown -R app:app /app

USER app
EXPOSE 12345

ENV RUST_LOG=info
ENTRYPOINT ["/app/thcdb-rs"]
